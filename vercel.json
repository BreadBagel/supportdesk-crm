{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "includeFiles": "data/db.json"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index?__route=/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}